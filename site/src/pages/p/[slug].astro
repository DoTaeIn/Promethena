---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProductDetail from "../../components/ProductDetail.astro";

export async function getStaticPaths() {
  const all = await getCollection("products");
  const enSlugs = new Set(all.filter((p) => p.id.endsWith(".en")).map((p) => p.id.replace(/\.en$/, "")));
  return all
    .filter((p) => p.id.endsWith(".ko"))
    .map((entry) => {
      const slug = entry.id.replace(/\.ko$/, "");
      return {
        params: { slug },
        props: { entry, hasEn: enSlugs.has(slug) },
      };
    });
}

const { entry, hasEn } = Astro.props;
const { Content } = await render(entry);
const legal = await getCollection("legal");
const policy = legal.find((e) => e.id === `${entry.id.replace(/\.ko$/, "")}.ko` && e.data.verifiedAgainstBuild);
const lang = "ko";
const slug = entry.id.replace(/\.ko$/, "");
---

<Base lang={lang} altPath={hasEn ? `/en/p/${slug}` : undefined} title={`${entry.data.name} — Promethena`}>
  <ProductDetail
    privacyHref={policy ? `/privacy/${policy.data.product}` : undefined}
    lang={lang}
    backHref="/"
    name={entry.data.name}
    tagline={entry.data.tagline}
    status={entry.data.status}
    tags={entry.data.tags}
    price={entry.data.price}
    demo={entry.data.demo}
  >
    <Content />
  </ProductDetail>
</Base>
