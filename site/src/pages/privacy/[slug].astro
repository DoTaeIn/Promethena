---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { CONTACT_EMAIL } from "../../lib/i18n";

// 실제 구현과 대조되지 않은 초안(verifiedAgainstBuild 없음)은 빌드에서 제외한다.
// 아직 배포되지 않은 제품의 방침을 공개하면 사실과 다른 고지가 된다.
export async function getStaticPaths() {
  const all = await getCollection("legal");
  const enSlugs = new Set(all.filter((e) => e.id.endsWith(".en")).map((e) => e.id.replace(/\.en$/, "")));
  return all
    .filter((e) => e.id.endsWith(".ko") && e.data.verifiedAgainstBuild)
    .map((entry) => {
      const slug = entry.id.replace(/\.ko$/, "");
      return { params: { slug }, props: { entry, hasEn: enSlugs.has(slug) } };
    });
}

const { entry, hasEn } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.replace(/\.ko$/, "");
---

<Base lang="ko" altPath={hasEn ? `/en/privacy/${slug}` : undefined} title={`${entry.data.product} 개인정보처리방침 — Promethena`}>
  <article class="legal prose">
    <a class="back" href={`/p/${slug}`}>← {entry.data.product}</a>
    <h1>{entry.data.product} 개인정보처리방침</h1>
    <p class="updated">최종 업데이트: {entry.data.updated}</p>

    <Content />

    <h2>문의</h2>
    <p>
      개인정보 관련 문의는 <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>로 연락해 주세요.
    </p>
    <p class="updated">
      이 문서는 {entry.data.product}에만 적용됩니다. Promethena 웹사이트 자체에 대한 안내는
      <a href="/privacy">사이트 개인정보처리방침</a>을 참고해 주세요.
    </p>
  </article>
</Base>

<style>
  .legal {
    padding: 24px 0 60px;
  }
  .updated {
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .back {
    display: inline-block;
    margin-bottom: 16px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-dim);
    text-decoration: none;
  }
  .legal :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0;
    font-size: 0.9rem;
  }
  .legal :global(th),
  .legal :global(td) {
    border: 1px solid var(--rule, #2a2a2a);
    padding: 8px 10px;
    text-align: left;
    vertical-align: top;
  }
</style>
