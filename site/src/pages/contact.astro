---
import Base from "../layouts/Base.astro";
import CompanyPage from "../components/CompanyPage.astro";
import InquiryLinks from "../components/InquiryLinks.astro";
import { CONTACT_EMAIL, inquiryMailto } from "../lib/i18n";
---
<Base lang="ko" altPath="/en/contact/" title="문의 — Promethena">
  <CompanyPage lang="ko" title="문의" description="목적에 맞는 메일을 선택하면 제목이 자동으로 채워집니다. 제품명이나 현재 상황을 함께 알려주시면 더 빠르게 확인할 수 있습니다.">
    <h2>문의 경로</h2>
    <InquiryLinks lang="ko" />
    <h2>일반 문의</h2>
    <p>위 경로에 맞지 않는 내용은 <a href={inquiryMailto("ko", "general")}>{CONTACT_EMAIL}</a>로 보내 주세요.</p>
  </CompanyPage>
</Base>
