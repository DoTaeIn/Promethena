---
import Base from "../../layouts/Base.astro";
import CompanyPage from "../../components/CompanyPage.astro";
import InquiryLinks from "../../components/InquiryLinks.astro";
---
<Base lang="en" altPath="/solutions/" title="Solutions — Promethena">
  <CompanyPage lang="en" title="Adopt a solution" description="Individuals can explore our products freely. For an organization, we first understand the adoption scope and any implementation work needed.">
    <h2>Personal use</h2>
    <p>Personal use is free by principle. Check each product’s current status and scope, then ask about personal use or its waitlist.</p>
    <h2>Organization adoption</h2>
    <p>For teams and companies, we first learn about your environment, intended users, and the integrations or extensions you need. This page does not invent a price or delivery date before that conversation.</p>
    <h2>Useful context for an inquiry</h2>
    <ul><li>The product you are considering</li><li>The workflow you want to improve</li><li>Access, integration, or extension needs inside your organization</li></ul>
    <InquiryLinks lang="en" />
  </CompanyPage>
</Base>
