---
import { ui, type Lang } from "../lib/i18n";

interface Props { lang: Lang; title: string; description: string; }
const { lang, title, description } = Astro.props;
const home = lang === "ko" ? "/" : "/en/";
---

<a class="back" href={home}>{ui[lang].back}</a>
<article class="company-page">
  <header>
    <h1>{title}</h1>
    <p>{description}</p>
  </header>
  <div class="prose"><slot /></div>
</article>

<style>
  .back { display: inline-block; margin: 24px 0; font-family: var(--font-mono); font-size: .8rem; color: var(--ink-dim); text-decoration: none; }
  .company-page { max-width: 760px; margin-bottom: 56px; background: var(--bg-panel); border: 1px solid var(--line); border-radius: 4px; padding: clamp(24px, 5vw, 48px); }
  header { padding-bottom: 28px; margin-bottom: 32px; border-bottom: 1px solid var(--line); }
  h1 { max-width: 12ch; margin: 0 0 12px; font-family: var(--font-display); font-size: clamp(3rem, 8vw, 5rem); font-weight: 400; line-height: .95; letter-spacing: .01em; }
  header p { max-width: 58ch; margin: 0; color: var(--ink-dim); font-size: 1.05rem; }
</style>
