---
import { statusLabel, ui, inquiryMailto, toolCopy, type Lang } from "../lib/i18n";
import InquiryLinks from "./InquiryLinks.astro";

interface Props {
  lang: Lang; backHref: string; name: string; tagline: string;
  status: "idea" | "prototype" | "beta" | "live"; tags: string[]; price?: number; demo?: string;
  kind?: "saas" | "tool";
  install?: string;
  /** 대조 완료된 방침이 있을 때만 넘어온다. */
  privacyHref?: string;
}
const { lang, backHref, name, tagline, status, tags, price, demo, privacyHref, kind = "saas", install } = Astro.props;
const tool = toolCopy[lang];
const copy = lang === "ko"
  ? { waitlist: "개인 사용 대기 등록", demo: "데모 보기", buy: "개인 사용 문의", idle: "아직 구상 단계입니다.", free: "무료", privacy: "개인정보처리방침" }
  : { waitlist: "Join personal waitlist", demo: "View demo", buy: "Ask about personal use", idle: "Still in the idea stage.", free: "Free", privacy: "Privacy policy" };
---

<a class="back" href={backHref}>{ui[lang].back}</a>
<article class="detail" data-status={status}>
  <header class="head">
    <span class="status-label">{statusLabel[lang][status]}</span>
    <h1 class="name">{name}</h1>
    <p class="tagline">{tagline}</p>
    <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>
  </header>
  <div class="actions">
    {status === "idea" && <p class="idle">{copy.idle}</p>}
    {kind === "tool" && status !== "idea" && (
      install
        ? <a class="btn primary" href={install} target="_blank" rel="noopener noreferrer">{tool.install}</a>
        : <p class="idle">{tool.soon}</p>
    )}
    {kind === "saas" && status === "prototype" && <a class="btn primary" href={inquiryMailto(lang, "waitlist", name)}>{copy.waitlist}</a>}
    {kind === "saas" && status === "beta" && <a class="btn primary" href={inquiryMailto(lang, "personal", name)}>{copy.buy}</a>}
    {kind === "saas" && status === "live" && <><span class="price-plate">{price === 0 ? copy.free : price !== undefined ? `$${price}` : null}</span><a class="btn primary" href={inquiryMailto(lang, "personal", name)}>{copy.buy}</a></>}
    {(status === "beta" || status === "live") && demo && <a class="btn" href={demo} target="_blank" rel="noopener noreferrer">{copy.demo}</a>}
    {status !== "idea" && kind === "saas" && <InquiryLinks lang={lang} product={name} compact />}
  </div>
  <div class="prose"><slot /></div>
  {privacyHref && (
    <footer class="detail-legal">
      <a href={privacyHref}>{copy.privacy} →</a>
    </footer>
  )}
</article>

<style>
  .detail-legal {
    margin-top: 40px;
    padding-top: 18px;
    border-top: 1px solid var(--rule, #2a2a2a);
  }
  .detail-legal a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-dim);
    text-decoration: none;
  }
  .detail-legal a:hover {
    color: var(--ink, inherit);
  }

  .back { display: inline-block; margin: 24px 0; font-family: var(--font-mono); font-size: .8rem; color: var(--ink-dim); text-decoration: none; }
  .detail { background: var(--bg-panel); border: 1px solid var(--line); border-radius: 4px; padding: 32px; margin-bottom: 40px; }
  .status-label { font-family: var(--font-mono); font-size: .75rem; text-transform: uppercase; letter-spacing: .06em; color: var(--steel-ink); }
  .detail[data-status="prototype"] .status-label { color: var(--amber-ink); }
  .detail[data-status="beta"] .status-label, .detail[data-status="live"] .status-label { color: var(--cyan-ink); }
  .name { font-family: var(--font-display); font-weight: 400; letter-spacing: .02em; font-size: 3rem; margin: 4px 0 8px; }
  .tagline { margin: 0 0 12px; color: var(--ink-dim); font-size: 1.05rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0 0 24px; padding: 0; }
  .tags li { font-family: var(--font-mono); font-size: .7rem; color: var(--ink-dim); border: 1px solid var(--line); border-radius: 2px; padding: 2px 6px; }
  .actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding-bottom: 24px; border-bottom: 1px solid var(--line); margin-bottom: 24px; }
  .idle { font-family: var(--font-mono); font-size: .85rem; color: var(--ink-dim); margin: 0; }
  .btn { display: inline-flex; align-items: center; min-height: 38px; font-family: var(--font-mono); font-size: .78rem; text-decoration: none; color: var(--ink); border: 1px solid var(--line); border-radius: 2px; padding: 8px 13px; }
  .btn.primary { background: var(--cyan); border-color: var(--cyan-ink); color: var(--bg-panel); }
  .detail[data-status="prototype"] .btn.primary { background: var(--amber); border-color: var(--amber-ink); }
  .price-plate { font-family: var(--font-mono); font-size: .85rem; font-weight: 700; border: 1px solid var(--cyan-ink); color: var(--cyan-ink); border-radius: 2px; padding: 6px 10px; }
  @media (max-width: 560px) { .detail { padding: 20px; } .name { font-size: 2.2rem; } }
</style>
